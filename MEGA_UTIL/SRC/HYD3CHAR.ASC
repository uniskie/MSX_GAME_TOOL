10 CLEAR1800,&HBEFF:DEFINT A-Z:PM=35:IM=69
20 CL$="FighterRobber Priest Monk   WarriorThief  Bishop Bishop Hero   "
30 WP$="45000102030405060708090a0b0c0d"'WEAPON
40 AR$="450e0f1011121342"'ARMOR
50 SH$="451415161718"'SHIELD
60 HE$="45191a1b1c"'HELM
70 KEYOFF:SCREEN0:WIDTH40:PRINT"HYDLIDE3 CHARACTER EDITOR
80 A=&H800+254*8:FOR I=2TO3:VPOKE A+I*2,&HAA:VPOKE A+I*2+1,&H55:NEXT
90 PRINT"USR5";:A$="FE02C02AF8F706FFAF862310FCC64A6F260022F8F7C9":FOR I=1TO LEN(A$)-1 STEP 2:POKE &HBF00+I\2,VAL("&H"+MID$(A$,I,2)):PRINT".";:NEXT:DEFUSR5=&HBF00:PRINT
100 AB=&HC000:DIM IT$(IM),PR$(PM),PL(3),PA(3),P$(2),OD(4)
110 ON STOP GOSUB 1300:STOPON:ON ERROR GOTO 2400
120 'PARAM
130 MV=22*2:MV$=STRING$(MV*2,255):PRINT"PARAM";
140 FOR I=0 TO PM:PRINT".";
150  READ PR$(I)
160  PR$=PR$(I):X=VAL(MID$(PR$(I),1,2)):Y=VAL(MID$(PR$(I),3,2))
170  J=Y*2+X\20:MID$(MV$,J*2+1,2)=RIGHT$("0"+MID$(STR$(I+1),2),2)
180 NEXT:PRINT
190 'ITEM
200 PRINT"ITEM";:FOR I=0 TO IM-1:PRINT".";
210  READ IT$(I)
220  IT$(I)=IT$(I)+SPACE$(16-LEN(IT$(I)))
230 NEXT:PRINT
240 IT$(I)=" --- empty ---  "
250 'CHKSUM
260 FOR I=0TO3
270  AD=AB+I*256:A=USR5(AD)
280  OD(I)=-((A=PEEK(AD+255))AND(0<>PEEK(AD)))
290 NEXT
300 '
310 'START
320 AD=AB+PI*256:OD=OD(PI)
330 X=0:Y=0:BN=0
340 'DRAW ALL
350 CLS:LOCATE,,0
360 FOR I=0 TO MV
370  N=VAL(MID$(MV$,I+I+1,2))-1
380  IF N>-1 THEN GOSUB 1390
390  I=I+(1-OD)*MV
400 NEXT
410 IF OD=O THEN PRINT" (NO DATA)"
420 'LOOP
430 BN=(BN+X+Y*2)*OD
440 IF BN>=MV THEN BN=BN-MV
450 IF BN<0 THEN BN=MV+BN
460 PN=VAL(MID$(MV$,BN*2+1,2))
470 IF PN=0 THEN 420
480 A$=PR$(PN-1)
490 LOCATE VAL(LEFT$(A$,2)),VAL(MID$(A$,3,2)),1:TIME=0:BK=1
500 IF TIME>29 THEN BK=1-BK:LOCATE,,BK:TIME=0
510 U=ASC(INKEY$+CHR$(0)):IF U=0 THEN 500
520 X=(U=29)-(U=28):Y=(U=30)-(U=31)
530 IF U<>13 AND U<>32 AND U<>8 THEN 420
540 N=PN-1:GOSUB 1670
550 IF U=8 AND PL(0)<>15 THEN 420
560 GOSUB 590'EDIT
570 IF PL>13 THEN 340'DRAW ALL
580 GOSUB 1390:GOTO 420'DRAW ONE
590 'EDIT 1 (CUR)
600 LOCATE 0,22,0:PRINT PR$;
610 IF PL(1)=5 OR PL(1)=3 THEN PRINT" (Cur)";
620 PRINT:PL=PL(0):DO=AD+PA(0):GOSUB 690
630 IF PL(1)<>5 AND PL(1)<>3 THEN 680
640 'EDIT 2 (MAX/BASE)
650 GOSUB 1390:LOCATE 0,22,0:PRINT SPACE$(39)
660 LOCATE 0,22:IF PL(1)=5 THEN PRINT PR$;" (Max)" ELSE PRINT PR$;" (Base)"
670 PL=PL(1):DO=AD+PA(1):GOSUB 690
680 LOCATE 0,22:PRINT SPACE$(39):RETURN
690 'EDIT SUB
700 ON PL GOSUB 720,730,740,750,760,770,780,790,800,810,820,830,840,850,1280:RETURN
710 'INPUT TYPES
720 GOSUB 1520:GOTO 1760'NAME
730 MX#=12:GOSUB 1490:GOTO 1890
740 MX#=255:GOSUB 1490:GOTO 1890
750 POKE DO,1-PEEK(DO):RETURN'FLAG
760 MX#=65535!:GOSUB 1500:GOTO 1890
770 GOTO 2270'CLASS
780 RETURN'G
790 MX#=16777215#:GOSUB 1510:GOTO 1890
800 EN$=WP$:GOTO 2170'WEAPON
810 EN$=AR$:GOTO 2170'ARMOR
820 EN$=SH$:GOTO 2170'SHIELD
830 EN$=HE$:GOTO 2170'HELM
840 GOTO 2070'ITEM
850 'DISP ITEM
860 CLS:PRINT"[Item Display]";STRING$(26,"-")
870 EM=19:VM=EM+4:VN=0:VX=0:VY=0
880 FOR VN=0 TO VM:GOSUB 1120:NEXT:VN=0
890 PRINT STRING$(40,"-");
900 PRINT"* ESC=END, RET=ITEM, N=NUM, SPC=USE";
910 '
920 VN=VN+VX+VY*2
930 IF VN>VM THEN VN=VN-VM-1
940 IF VN<0 THEN VN=VM+VN+1
950 IF VN=VM THEN 920'SKIP
960 IF VN>EM THEN VA=&H83+VN-EM-1 ELSE VA=&H47+VN*3
970 LOCATE (VN AND 1)*20,(VN\2)+1,1:TIME=0:BK=1
980 IF TIME>29 THEN BK=1-BK:LOCATE,,BK:TIME=0
990 K=ASC(INKEY$+CHR$(0)):IF K=0 THEN 980
1000 VX=(K=29)-(K=28):VY=(K=30)-(K=31)
1010 IF K=78 OR K=110 THEN 1050'N/n
1020 IF K=13 THEN IF VN>EM THEN 1050 ELSE 1070'RETURN
1030 IF K=32 THEN IF VN>EM THEN 1050 ELSE 1060'SPACE
1040 IF K=27 THEN LOCATE,,0:PL=14:RETURN ELSE 910
1050 P$(0)="Count":PA(0)=VA-(VN<=EM):PL(0)=3:PL(1)=0:GOTO 1080
1060 P$(0)="Using":PA(0)=VA+2:PL(0)=4:PL(1)=0:GOTO 1080
1070 P$(0)="Item":PA(0)=VA+0:PL(0)=13:PL(1)=0:GOTO 1080
1080 DO=AD+PA(0):GOSUB 1090:PR$=A$+" - "+P$(0):GOSUB 590:LOCATE,,0:GOSUB1120:GOTO 910
1090 'ITEM NAME VN
1100 IF VN>EM THEN A$=IT$(47+VN-EM-1):RETURN
1110 HI=PEEK(AD+VA):IF HI<IM THEN A$=IT$(HI):RETURN ELSE A$=IT$(IM):RETURN
1120 'DRAW ITEM
1130 IF VN>=VM THEN PRINT SPC(20);:RETURN ELSE IF VN>EM THEN 1210
1140  DO=AD+&H47+VN*3
1150  HI=PEEK(DO)
1160  IC$=MID$(STR$(PEEK(DO+1)),2)
1170  IF HI<IM THEN A$=IT$(HI) ELSE A$=IT$(IM)
1180  LOCATE (VN AND 1)*20,(VN\2)+1
1190  PRINT RIGHT$("  "+IC$,3);MID$(":+",1+PEEK(DO+2),1);A$;
1200 RETURN
1210 'COIN
1220  A=VN-EM-1:DO=AD+&H83+A
1230  IC$=MID$(STR$(PEEK(DO)),2)
1240  A$=IT$(47+A)
1250  LOCATE (VN AND 1)*20,(VN\2)+1
1260  PRINT RIGHT$("  "+IC$,3);":";A$;
1270 RETURN
1280 'CHG CHAR
1290 PI=(PI+1+(U=8)*2)AND3:GOTO310'DRAW ALL
1300 'END
1310 LOCATE,,0:BEEP
1320 FOR I=0TO3
1330  IF OD(I) THEN AD=AB+I*256:A=USR5(AD):POKE AD+255,A
1340 NEXT
1350 LOCATE0,0:PRINTSPC(40):POKE &HFBB2,&HAF:LOCATE0,0:PRINT"RUN"+CHR$(34)+"HYDLIDE3.BAS"
1360 A=&HF3F8:POKE A,&HF3:POKE A+1,&HFB:POKE A+2,&HF0:POKE A+3,&HFB:POKE &HFBF0,30:POKE &HFBF1,30:POKE &HFBF2,14
1370 ON ERROR GOTO 0:END
1380 '
1390 'DRAW PARAM
1400 A$=PR$(N):GOSUB 1670:P=0
1410 LOCATE CX,CY,0
1420 PRINT PR$;
1430 PL=PL(P):P$=P$(P)
1440 DO=AD+PA(P)
1450 ON PL GOSUB 1520,1490,1490,1600,1500,1590,1620,1510,1540,1550,1560,1570,1530,1610,1630
1460 IF PL=0 THEN DO=AD+PA(0):RETURN
1470 PRINT P$;PP$;
1480 P=P+1:GOTO 1430
1490 A#=PEEK(DO):GOTO 1650
1500 A#=PEEK(DO)+PEEK(DO+1)*256:GOTO 1650
1510 A#=PEEK(DO)+PEEK(DO+1)*256+PEEK(DO+2)*65536!:GOTO 1650
1520 PP$="":FOR K=0 TO 15:A=PEEK(DO+K):PP$=PP$+CHR$(A-(A=0)*32):NEXT:RETURN
1530 A=PEEK(DO):IF(A<IM)THEN PP$=IT$(A):RETURN ELSE PP$=IT$(IM):RETURN'ITEM
1540 A=PEEK(DO):E=A- 1:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'WEAPON
1550 A=PEEK(DO):E=A+13:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'ARMOR
1560 A=PEEK(DO):E=A+19:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'SHIELD
1570 A=PEEK(DO):E=A+24:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'HELM
1580 MX=LEN(EN$)\2-1:IF(A>0)AND(A<=MX)THEN PP$=IT$(VAL("&H"+MID$(EN$,2*A+1,2))):RETURN ELSE PP$=IT$(IM):RETURN
1590 PP$=MID$(CL$,PEEK(DO)*7+1,7):RETURN
1600 PP$=MID$("OffOn ",PEEK(DO)*3+1,3):RETURN
1610 PL=0:RETURN
1620 PRINT"g":PL=0:RETURN
1630 PP$=HEX$(PI):RETURN
1640 '
1650 PP$=STR$(A#):PP$=RIGHT$(PP$,LEN(PP$)-1)
1660 PP$=RIGHT$("0000000"+PP$,PL):RETURN
1670 'GET PARAM
1680 CX=VAL(LEFT$(A$,2)):CY=VAL(MID$(A$,3,2))
1690 D=INSTR(A$,":"):PR$=MID$(A$,5,D-5)
1700 FOR K=0 TO 2
1710  PL(K)=VAL("&H"+MID$(A$,D+K*4+1,1))
1720  PA(K)=VAL("&H"+MID$(A$,D+K*4+2,2))
1730  P$(K)=MID$(A$,D+K*4,1)
1740 NEXT:RETURN
1750 '
1760 'INPUT NAME
1770 NL=15:PP$="":FOR K=0TO NL:PP$=PP$+CHR$(PEEK(DO+K)):NEXT
1780 IX=0:IY=PEEK(&HF3DC)-1:LOCATE0:PRINT"Input Name:";:GOSUB 1880
1790 LOCATE11+IX,,1:A=ASC(INPUT$(1))
1800 IF(A>31)AND(A<>127)THEN MID$(PP$,IX+1,1)=CHR$(A):PRINT CHR$(A);:A=28
1810 IF A=127 THEN PP$=LEFT$(PP$,IX)+MID$(PP$,IX+2)+CHR$(0):LOCATE11,,0:GOSUB 1880
1820 IF(A=8)AND(IX>0)THEN IX=IX-1:PP$=LEFT$(PP$,IX)+MID$(PP$,IX+2)+CHR$(0):LOCATE11,,0:GOSUB 1880
1830 IX=IX+(A=29 AND IX>0)-(A=28 AND IX<NL)
1840 IF A=27 THEN 2380'ENDI
1850 IF A<>13 THEN 1790
1860 PP$=LEFT$(PP$+STRING$(16,0),16):FOR K=OTO15:POKE DO+K,ASC(MID$(PP$,K+1,1)):NEXT
1870 GOTO 2380'ENDI
1880 FOR K=0TO NL:A=ASC(MID$(PP$,K+1,1)):PRINT CHR$(-A*(A>31 AND A<>127)-254*(A<32 OR A=127));:NEXT:RETURN
1890 'INPUT NUM
1900 IX=PL-1:FI=1:IY=PEEK(&HF3DC)-1
1910 PRINT CHR$(13)+"Input Num:";PP$;" Max:";MX#;
1920 LOCATE IX+10,,1:A=ASC(INPUT$(1))
1930 IF FI=1 AND A>47 AND A<58 THEN PP$=STRING$(LEN(PP$),"0"):FI=2
1940 IF FI=2 AND A>47 AND A<58 THEN PP$=MID$(PP$,2)+CHR$(A):LOCATE 10,,0:PRINT PP$;:LOCATE IX+10,,1
1950 IF FI=0 AND A>47 AND A<58 THEN MID$(PP$,IX+1,1)=CHR$(A):PRINT CHR$(A);:IX=IX+1:IF IX>=PL THEN IX=PL-1:FI=2
1960 IF A=29 OR A=28 THEN FI=0:IX=IX+(A=29 AND IX>0)-(A=28):IF IX>=PL THEN IX=PL-1
1970 IF A=27 THEN 2380'ENDI
1980 IF A<>13 AND A<>32THEN 1920
1990 A#=VAL(PP$)
2000 IF A#>MX# THEN BEEP:GOTO 1920
2010 A2=INT(A#/65536#):A3#=A#-A2*65536#
2020 A1=INT(A3#/256#):A0=A3#-A1*256#
2030 POKE DO,A0
2040 IF MX#>256# THEN POKE DO+1,A1
2050 IF MX#>65535# THEN POKE DO+2,A2
2060 GOTO 2380'ENDI
2070 'SELECT ITEM
2080 MX=IM:EN=PEEK(DO):IF EN>IM THENEN=IM
2090 PRINT CHR$(13)+"Item(";RIGHT$(" "+MID$(STR$(EN),2),2);"):";IT$(EN);
2100 A=ASC(INPUT$(1))
2110 EN=EN+(A=30)+(A=29)-(A=31)-(A=28)
2120 IF EN<0 THEN EN=MX
2130 IF EN>MX THEN EN=0
2140 IF A=27 THEN 2380'ENDI
2150 IF A<>13 AND A<>32 THEN 2090
2160 IF EN=MX THEN EN=255:GOTO 2360 ELSE 2360'WRITE&ENDI
2170 'SELECT EQUIP
2180 MX=LEN(EN$)\2-1:EN=PEEK(DO):EB=VAL("&H"+MID$(EN$,3,2)):IF EN>MX THEN EN=MX
2190 E=VAL("&H"+MID$(EN$,EN*2+1,2)):EI=-(E-EB+1)*(EN>0):PRINT CHR$(13)+"Equipment(";HEX$(EI);"):";IT$(E);
2200 A=ASC(INPUT$(1))
2210 EN=EN+(A=30)+(A=29)-(A=31)-(A=28)
2220 IF EN<0 THEN EN=MX
2230 IF EN>MX THEN EN=0
2240 IF A=27 THEN 2380'ENDI
2250 IF A<>13 AND A<>32 THEN 2190
2260 EN=EI:GOTO 2360'WRITE&ENDI
2270 'SELECT CLASS
2280 MX=LEN(CL$)\7-1:EN=PEEK(DO)
2290 PRINT CHR$(13)+"Class(";HEX$(EN);"):";MID$(CL$,EN*7+1,7);
2300 A=ASC(INPUT$(1))
2310 EN=EN+(A=30)+(A=19)-(A=31)-(A=28)
2320 IF EN<0 THEN EN=MX
2330 IF EN>MX THEN EN=0
2340 IF A=27 THEN 2380'ENDI
2350 IF A<>13 AND A<>32 THEN 2290
2360 'WRITE
2370 POKE DO,EN
2380 'END INPUT
2390 LOCATE 0,,0:PRINT CHR$(13);SPC(39);:RETURN
2400 'ERR
2410 FOR I=0TO3
2420  IF OD(I) THEN AD=AB+I*256:A=USR5(AD):POKE AD+255,A
2430 NEXT
2440 ON ERROR GOTO 0:RESUME
2450 '
2460 'PARAM
2470 DATA"0000No.:f00/0"
2480 DATA"0001Name:100/0
2490 DATA"0002Class  :613/0
2500 DATA"0003Level  :312/0
2510 DATA"2003Magic Level :224/0
2520 DATA"2900Savior :4fc/0
2530 DATA"2901Fairy  :43b/0
2540 DATA"2902Monster:43c/0
2550 DATA"0005Life   :516/514/0
2560 DATA"0006Magic  :520/51e/0
2570 DATA"0007Experience:835/0
2580 DATA"2005Attack Point:325/326/0
2590 DATA"2006Armor Class :327/328/0
2600 DATA"2007Agility     :329/32a/0
2610 DATA"0008Strength   :31c/31d/0
2620 DATA"2008Dextality   :32c/32d/0
2630 DATA"0009Mind Force :334/0
2640 DATA"2009Inteligence :32e/32f/0
2650 DATA"0010Charm      :332/333/0
2660 DATA"2010Luck        :330/331/0
2670 DATA"0011Have Weight:53eg7
2680 DATA"2011Master Weight:540g7
2690 DATA"0012<< Item Display >>:e47/0
2700 DATA"2212Item Weight:542g7
2710 DATA"0014Weapon:993/0
2720 DATA"0015Armor :a94/0
2730 DATA"0016Shield:b95/0
2740 DATA"0017Helmet:c96/0
2750 DATA"2314Attack Range :397/0
2760 DATA"2315Shot Distance:398/0
2770 DATA"2316Bullet Shape :399/0
2780 DATA"2317Attack Wait  :3b8/0
2790 DATA"0019Elevator Move:490/0
2800 DATA"2019Palace Riging:492/0
2810 DATA"0020T&E Pack Open:48f/0
2820 DATA"2020ExAmuet Taken:48c/0
2830 'ITEM
2840 DATA"Dagger","Short Sword","Long Sword","Holy Sword"
2850 DATA"Silver Sword","Fire Sword","Laser Sword","sling"
2860 DATA"Spear","Little Bow","Great Bow","Club"
2870 DATA"Axe","Battle Axe","Leather Suit","Chain Suit"
2880 DATA"Steal Armor","Silver Armor","Magic Armor","Fairy Armor"
2890 DATA"Shield","Mind Shield","Steel Shield","Life Sield"
2900 DATA"Fairy Shield","Helmet","Yamatec","Star Helmet"
2910 DATA"Fairy Helmet","Heal","Antidote","Herb"
