1000 CLEAR1800,&HBEFF:DEFINT A-Z:PM=31:IM=69
1010 CL$="FighterRobber Priest Monk   WarriorThief  Bishop Bishop Hero   "
1020 WP$="45000102030405060708090a0b0c0d"'WEAPON
1030 AR$="450e0f1011121342"'ARMOR
1040 SH$="451415161718"'SHIELD
1050 HE$="45191a1b1c"'HELM
1060 KEYOFF:SCREEN0:WIDTH40
1070 A=&H800+254*8:FORI=2TO3:VPOKE A+I*2,&HAA:VPOKE A+I*2+1,&H55:NEXT
1080 PRINT"USR5";:A$="FE02C02AF8F706FFAF862310FCC64A6F260022F8F7C9":FOR I=1TO LEN(A$)-1 STEP 2:POKE &HBF00+I\2,VAL("&H"+MID$(A$,I,2)):PRINT".";:NEXT:DEFUSR5=&HBF00:PRINT
1090 AB=&HC000:DIM IT$(IM),PR$(PM),PL(3),PA(3),P$(2),OD(4)
1100 ON STOP GOSUB 2270:STOPON:ON ERROR GOTO 3290
1110 'PARAM
1120 MV=20*2:MV$=STRING$(MV*2,255):PRINT"PARAM";
1130 FOR I=0 TO PM:PRINT".";
1140  READ PR$(I)
1150  PR$=PR$(I):X=VAL(MID$(PR$(I),1,2)):Y=VAL(MID$(PR$(I),3,2))
1160  J=Y*2+X\20:MID$(MV$,J*2+1,2)=RIGHT$("0"+MID$(STR$(I+1),2),2)
1170 NEXT:PRINT
1180 'ITEM
1190 PRINT"ITEM";:FOR I=0 TO IM-1:PRINT".";
1200  READ IT$(I)
1210  IT$(I)=IT$(I)+SPACE$(16-LEN(IT$(I)))
1220 NEXT:PRINT
1230 IT$(I)=" --- empty ---  "
1240 'CHKSUM
1250 FOR I=0TO3
1260  AD=AB+I*256:A=USR5(AD)
1270  OD(I)=-((A=PEEK(AD+255))AND(0<>PEEK(AD)))
1280 NEXT
1290 '
1300 'START
1310 AD=AB+PI*256:OD=OD(PI)
1320 X=0:Y=0:BN=0
1330 'DRAW
1340 CLS:LOCATE0,23,0:PRINT"HYDLIDE III CHARACTER EDITOR";:LOCATE0,0
1350 FOR I=0 TO MV
1360  N=VAL(MID$(MV$,I+I+1,2))-1
1370  IF N>-1 THEN GOSUB 2360
1380  I=I+(1-OD)*MV
1390 NEXT
1400 IF OD=O THEN PRINT" (NO DATA)"
1410 'LOOP
1420 BN=(BN+X+Y*2)*OD
1430 IF BN>=MV THEN BN=BN-MV
1440 IF BN<0 THEN BN=MV+BN
1450 PN=VAL(MID$(MV$,BN*2+1,2))
1460 IF PN=0 THEN 1410
1470 A$=PR$(PN-1)
1480 LOCATE VAL(LEFT$(A$,2)),VAL(MID$(A$,3,2)),1:TIME=0:BK=1
1490 IF TIME>29 THEN BK=1-BK:LOCATE,,BK:TIME=0
1500 K=ASC(INKEY$+CHR$(0)):IF K=0 THEN 1490
1510 X=(K=29)-(K=28):Y=(K=30)-(K=31)
1520 IF K<>13 THEN 1410
1530 N=PN-1:GOSUB 2640:GOSUB 1560 'EDIT
1540 IF PL>13 THEN 1330'REDRAW
1550 GOSUB 2360:GOTO 1410
1560 'EDIT 1 (CUR)
1570 LOCATE 0,20,0:PRINT PR$;
1580 IF PL(1)=5 OR PL(1)=3 THEN PRINT" (Cur)";
1590 PRINT:PL=PL(0):DO=AD+PA(0):GOSUB 1660
1600 IF PL(1)<>5 AND PL(1)<>3 THEN 1650
1610 'EDIT 2 (MAX/BASE)
1620 GOSUB 2360:LOCATE 0,20:PRINT SPACE$(39)
1630 LOCATE 0,20,0:IF PL(1)=5 THEN PRINT PR$;" (Max)" ELSE PRINT PR$;" (Base)"
1640 PL=PL(1):DO=AD+PA(1):GOSUB 1660
1650 LOCATE 0,20:PRINT SPACE$(39):RETURN
1660 'EDIT SUB
1670 ON PL GOSUB 1690,1700,1710,1720,1730,1740,1750,1760,1770,1780,1790,1800,1810,1820,2250:RETURN
1680 'INPUT TYPES
1690 GOSUB 2490:GOTO 2730'NAME
1700 MX#=12:GOSUB 2460:GOTO 2840
1710 MX#=255:GOSUB 2460:GOTO 2840
1720 POKE DO,1-PEEK(DO):RETURN'FLAG
1730 MX#=65535!:GOSUB 2470:GOTO 2840
1740 GOTO 3170'CLASS
1750 RETURN'G
1760 MX#=16777215#:GOSUB 2480:GOTO 2840
1770 EN$=WP$:GOTO 3080'WEAPON
1780 EN$=AR$:GOTO 3080'ARMOR
1790 EN$=SH$:GOTO 3080'SHIELD
1800 EN$=HE$:GOTO 3080'HELM
1810 GOTO 2990'ITEM
1820 'DISP ITEM
1830 CLS:PRINT"[Item Display]";STRING$(26,"-")
1840 EM=19:VM=EM+4:VN=0:VX=0:VY=0
1850 FOR VN=0 TO VM:GOSUB 2090:NEXT:VN=0
1860 PRINT STRING$(40,"-");
1870 PRINT"* ESC=END, RET=ITEM, N=NUM, SPC=USE";
1880 '
1890 VN=VN+VX+VY*2
1900 IF VN>VM THEN VN=VN-VM-1
1910 IF VN<0 THEN VN=VM+VN+1
1920 IF VN=VM THEN 1890'SKIP
1930 IF VN>EM THEN VA=&H83+VN-EM-1 ELSE VA=&H47+VN*3
1940 LOCATE (VN AND 1)*20,(VN\2)+1,1:TIME=0:BK=1
1950 IF TIME>29 THEN BK=1-BK:LOCATE,,BK:TIME=0
1960 K=ASC(INKEY$+CHR$(0)):IF K=0 THEN 1950
1970 VX=(K=29)-(K=28):VY=(K=30)-(K=31)
1980 IF K=78 OR K=110 THEN 2020'N/n
1990 IF K=13 THEN IF VN>EM THEN 2020 ELSE 2040 'RETURN
2000 IF K=32 THEN IF VN>EM THEN 2020 ELSE 2030'SPACE
2010 IF K=27 THEN PL=14:RETURN ELSE 1880
2020 P$(0)="Count":PA(0)=VA-(VN<=EM):PL(0)=3:PL(1)=0:GOTO 2050
2030 P$(0)="Using":PA(0)=VA+2:PL(0)=4:PL(1)=0:GOTO 2050
2040 P$(0)="Item":PA(0)=VA+0:PL(0)=13:PL(1)=0:GOTO 2050
2050 DO=AD+PA(0):GOSUB 2060:PR$=A$+" - "+P$(0):GOSUB 1560:LOCATE,,0:GOSUB2090:GOTO 1880
2060 'ITEM NAME VN
2070 IF VN>EM THEN A$=IT$(47+VN-EM-1):RETURN
2080 HI=PEEK(AD+VA):IF HI<IM THEN A$=IT$(HI):RETURN ELSE A$=IT$(IM):RETURN
2090 'DRAW ITEM
2100 IF VN>=VM THEN PRINT SPC(20);:RETURN ELSE IF VN>EM THEN 2180
2110  DO=AD+&H47+VN*3
2120  HI=PEEK(DO)
2130  IC$=MID$(STR$(PEEK(DO+1)),2)
2140  IF HI<IM THEN A$=IT$(HI) ELSE A$=IT$(IM)
2150  LOCATE (VN AND 1)*20,(VN\2)+1
2160  PRINT RIGHT$("  "+IC$,3);MID$(":+",1+PEEK(DO+2),1);A$;
2170 RETURN
2180 'COIN
2190  A=VN-EM-1:DO=AD+&H83+A
2200  IC$=MID$(STR$(PEEK(DO)),2)
2210  A$=IT$(47+A)
2220  LOCATE (VN AND 1)*20,(VN\2)+1
2230  PRINT RIGHT$("  "+IC$,3);":";A$;
2240 RETURN
2250 'CHG CHAR
2260 PI=(PI+1)AND3:GOTO1300 'REFRESH
2270 'END
2280 LOCATE,,0:BEEP
2290 FOR I=0TO3
2300  IF OD(I) THEN AD=AB+I*256:A=USR5(AD):POKE AD+255,A
2310 NEXT
2320 LOCATE0,0:PRINTSPC(40):POKE &HFBB2,&HAF:LOCATE0,0:PRINT"RUN"+CHR$(34)+"HYDLIDE3.BAS"
2330 A=&HF3F8:POKE A,&HF3:POKE A+1,&HFB:POKE A+2,&HF0:POKE A+3,&HFB:POKE &HFBF0,30:POKE &HFBF1,30:POKE &HFBF2,14
2340 ON ERROR GOTO 0:END
2350 '
2360 'DRAW PARAM
2370 A$=PR$(N):GOSUB 2640:P=0
2380 LOCATE CX,CY,0
2390 PRINT PR$;
2400 PL=PL(P):P$=P$(P)
2410 DO=AD+PA(P)
2420 ON PL GOSUB 2490,2460,2460,2570,2470,2560,2590,2480,2510,2520,2530,2540,2500,2580,2600
2430 IF PL=0 THEN DO=AD+PA(0):RETURN
2440 PRINT P$;PP$;
2450 P=P+1:GOTO 2400
2460 A#=PEEK(DO):GOTO 2620
2470 A#=PEEK(DO)+PEEK(DO+1)*256:GOTO 2620
2480 A#=PEEK(DO)+PEEK(DO+1)*256+PEEK(DO+2)*65536!:GOTO 2620
2490 PP$="":FOR K=0 TO 15:A=PEEK(DO+K):PP$=PP$+CHR$(A-(A=0)*32):NEXT:RETURN
2500 A=PEEK(DO):IF(A<IM)THEN PP$=IT$(A):RETURN ELSE PP$=IT$(IM):RETURN'ITEM
2510 A=PEEK(DO):E=A- 1:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'WEAPON
2520 A=PEEK(DO):E=A+13:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'ARMOR
2530 A=PEEK(DO):E=A+19:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'SHIELD
2540 A=PEEK(DO):E=A+24:IF(A>0)AND(E<IM)THEN PP$=IT$(E):RETURN ELSE PP$=IT$(IM):RETURN'HELM
2550 MX=LEN(EN$)\2-1:IF(A>0)AND(A<=MX)THEN PP$=IT$(VAL("&H"+MID$(EN$,2*A+1,2))):RETURN ELSE PP$=IT$(IM):RETURN
2560 PP$=MID$(CL$,PEEK(DO)*7+1,7):RETURN
2570 PP$=MID$("OffOn ",PEEK(DO)*3+1,3):RETURN
2580 PL=0:RETURN
2590 PRINT"g":PL=0:RETURN
2600 PP$=HEX$(PI):RETURN
2610 '
2620 PP$=STR$(A#):PP$=RIGHT$(PP$,LEN(PP$)-1)
2630 PP$=RIGHT$("0000000"+PP$,PL):RETURN
2640 'GET PARAM
2650 CX=VAL(LEFT$(A$,2)):CY=VAL(MID$(A$,3,2))
2660 D=INSTR(A$,":"):PR$=MID$(A$,5,D-5)
2670 FOR K=0 TO 2
2680  PL(K)=VAL("&h"+MID$(A$,D+K*4+1,1))
2690  PA(K)=VAL("&h"+MID$(A$,D+K*4+2,2))
2700  P$(K)=MID$(A$,D+K*4,1)
2710 NEXT:RETURN
2720 '
2730 'INPUT NAME
2740 NL=15:PP$="":FOR K=0TO NL:PP$=PP$+CHR$(PEEK(DO+K)):NEXT
2750 IX=0:IY=PEEK(&HF3DC)-1:LOCATE0:PRINT"Input Name:";:GOSUB 2830
2760 LOCATE11+IX,,1:A=ASC(INPUT$(1))
2770 IF(A>31)AND(A<>127)THEN MID$(PP$,IX+1,1)=CHR$(A):PRINT CHR$(A);:A=28
2780 IF A=127 THEN PP$=LEFT$(PP$,IX)+MID$(PP$,IX+2)+CHR$(0):LOCATE11,,0:GOSUB 2830
2790 IX=IX+(A=29 AND IX>0)-(A=28 AND IX<NL)
2800 IF A<>13 THEN 2760
2810 PP$=LEFT$(PP$+STRING$(16,0),16):FORI=OTO15:POKE DO+I,ASC(MID$(PP$,I+1,1)):NEXT
2820 LOCATE0,IY:GOTO 3270'END
2830 FORI=0TO NL:A=ASC(MID$(PP$,I+1,1)):PRINT CHR$(-A*(A>31 AND A<>127)-254*(A<32 OR A=127));:NEXT:RETURN
2840 'INPUT NUM
2850 IX=0:IY=PEEK(&HF3DC)-1
2860 PRINT CHR$(13)+"Input Num:";PP$;" Max:";MX#;
2870 LOCATE IX+10,,1:A=ASC(INPUT$(1))
2880 IF A>47 AND A<58 THEN MID$(PP$,IX+1,1)=CHR$(A):PRINT CHR$(A);:A=28
2890 IX=IX+(A=29 AND IX>0)-(A=28):IF IX=PL THEN IX=0
2900 IF A<>13 THEN 2870
2910 A#=VAL(PP$)
2920 IF A#>MX# THEN BEEP:GOTO 2870
2930 A2=INT(A#/65536#):A3#=A#-A2*65536#
2940 A1=INT(A3#/256#):A0=A3#-A1*256#
2950 POKE DO,A0
2960 IF MX#>256# THEN POKE DO+1,A1
2970 IF MX#>65535# THEN POKE DO+2,A2
2980 GOTO 3270'ENDI
2990 'SEL ITEM
3000 MX=IM:EN=PEEK(DO):IF EN>IM THENEN=IM
3010 PRINT CHR$(13)+"Item(";RIGHT$(" "+MID$(STR$(EN),2),2);"):";IT$(EN);
3020 A=ASC(INPUT$(1))
3030 EN=EN+(A=30)+(A=29)-(A=31)-(A=28)
3040 IF EN<0 THEN EN=MX
3050 IF EN>MX THEN EN=0
3060 IF A<>13 THEN 3010
3070 IF EN=MX THEN EN=255:GOTO 3250 ELSE 3250'WRITE&ENDI
3080 'SEL EQUIP
3090 MX=LEN(EN$)\2-1:EN=PEEK(DO):EB=VAL("&h"+MID$(EN$,3,2)):IF EN>MX THEN EN=MX
3100 E=VAL("&h"+MID$(EN$,EN*2+1,2)):EI=-(E-EB+1)*(EN>0):PRINT CHR$(13)+"Equipment(";HEX$(EI);"):";IT$(E);
3110 A=ASC(INPUT$(1))
3120 EN=EN+(A=30)+(A=29)-(A=31)-(A=28)
3130 IF EN<0 THEN EN=MX
3140 IF EN>MX THEN EN=0
3150 IF A<>13 THEN 3100
3160 EN=EI:GOTO 3250'WRITE&ENDI
3170 'SEL CLASS
3180 MX=LEN(CL$)\7-1:EN=PEEK(DO)
3190 PRINT CHR$(13)+"Class(";HEX$(EN);"):";MID$(CL$,EN*7+1,7);
3200 A=ASC(INPUT$(1))
3210 EN=EN+(A=30)+(A=19)-(A=31)-(A=28)
3220 IF EN<0 THEN EN=MX
3230 IF EN>MX THEN EN=0
3240 IF A<>13 THEN 3190
3250 'WRITE
3260 POKE DO,EN
3270 'END INPUT
3280 LOCATE 0,,0:PRINT CHR$(13);SPC(39);:RETURN
3290 'ERR
3300 FOR I=0TO3
3310  IF OD(I) THEN AD=AB+I*256:A=USR5(AD):POKE AD+255,A
3320 NEXT
3330 ON ERROR GOTO 0:RESUME
3340 '
3350 'PARAM
3360 DATA"0000No.:f00/0"
3370 DATA"0001Name:100/0
3380 DATA"3001Savior:4fc/0
3390 DATA"0002Class  :613/0
3400 DATA"3002Fairy :43b/0
3410 DATA"0003Monster:43c/0
3420 DATA"0004Level  :312/0
3430 DATA"2504Magic Spell:224/0
3440 DATA"0006Life   :516/514/0
3450 DATA"0007Magic  :520/51e/0
3460 DATA"0008Experience:835/0
3470 DATA"2006Attack Point:325/326/0
3480 DATA"2007Armor Class :327/328/0
3490 DATA"2008Agility     :329/32a/0
3500 DATA"0009Strength   :31c/31d/0
3510 DATA"2009Dextality   :32c/32d/0
3520 DATA"0010Mind Force :334/0
3530 DATA"2010Inteligence :32e/32f/0
3540 DATA"0011Charm      :332/333/0
3550 DATA"2011Luck        :330/331/0
3560 DATA"0012Have Weight:53eg7
3570 DATA"2012Master Weight:540g7
3580 DATA"0013* [ Item Display ]:e47/0
3590 DATA"2213Item Weight:542g7
3600 DATA"0015Weapon:993/0
3610 DATA"0016Armor :a94/0
3620 DATA"0017Shield:b95/0
3630 DATA"0018Helmet:c96/0
3640 DATA"2315Attack Range :397/0
3650 DATA"2316Shot Distance:398/0
3660 DATA"2317Bullet Shape :399/0
3670 DATA"2318Attack Wait  :3b8/0
3680 'ITEM
3690 DATA"Dagger","Short Sword","Long Sword","Holy Sword"
3700 DATA"Silver Sword","Fire Sword","Laser Sword","sling"
3710 DATA"Spear","Little Bow","Great Bow","Club"
3720 DATA"Axe","Battle Axe","Leather Suit","Chain Suit"
3730 DATA"Steal Armor","Silver Armor","Magic Armor","Fairy Armor"
3740 DATA"Shield","Mind Shield","Steel Shield","Life Sield"
3750 DATA"Fairy Shield","Helmet","Yamatec","Star Helmet"
3760 DATA"Fairy Helmet","Heal","Antidote","Herb"
3770 DATA"+3 Heal","+5 Heal","Max Heal","Cup of Soma"
3780 DATA"Phony Medicine","Gold Exchanger","Cross of God","Stone of Fighter"
3790 DATA"Tool of Camp","Midnight eye","Amulet of Magic","Food"
3800 DATA"Lamp","Oil","Super Oil","$10-Coin"
3810 DATA"$100-Coin","$1000-Coin","VIP Card","Cream of NIBEA'N"
3820 DATA"Amulet of ATSUTA","Doll of YUMI","T&E Package","Odo-Later"
3830 DATA"Stone of Pickles","Sun-Oil","Fang of Dragon","JIM'S Scroll"
3840 DATA"ID-Card","Stone of Cloud","Bugle","Idol of VARARYS"
3850 DATA"Amulet of Exit","Space Compass","Space Suit","Amulet of DM"
3860 DATA"Holy water"
